# Backend environment (server/.env) — copy to server/.env and fill in values.
# This file is gitignored and must be recreated on every machine/deployment.

PORT=5001
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-value

# Public client origin. The server redirects here after Google sign-in.
CLIENT_URL=http://localhost:5174

EMAIL_USER=
EMAIL_PASS=
SUPPORT_EMAIL=

CSC_API_KEY=

# AI providers
AI_PROVIDER=groq
AI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# Ask AI provider (Groq). Falls back to GROQ_API_KEY / GROQ_MODEL.
ASK_GROQ_API_KEY=
ASK_GROQ_MODEL=llama-3.1-8b-instant

# ATS provider
ATS_AI_PROVIDER=groq
ATS_GROQ_MODEL=groq/compound-mini

# Google OAuth (student sign-in)
# Create an OAuth client (Web application) in Google Cloud Console, then:
#  1. Put its Client ID and Client Secret here.
#  2. Register GOOGLE_CALLBACK_URL below as an "Authorized redirect URI".
#  3. Restart the server after changing this file.
# For a separated deployment, use the public backend origin, e.g.
#   GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5174/api/auth/google/callback

# Razorpay Payments (test/live paired; PAYMENTS_ENABLED flips to true only when
# key_id + key_secret + webhook_secret for the active mode are all set)
PAYMENTS_ENABLED=false
RAZORPAY_MODE=test

RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_WEBHOOK_SECRET=


RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_WEBHOOK_SECRET=